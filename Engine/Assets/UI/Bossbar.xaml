<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920" d:DesignHeight="1080">

    <Grid.RowDefinitions>
        <RowDefinition Height="5*"/>
        <RowDefinition Height="754*"/>
        <RowDefinition Height="76*"/>
        <RowDefinition Height="196*"/>
        <RowDefinition Height="49*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="580*"/>
        <ColumnDefinition Width="760*"/>
        <ColumnDefinition Width="580*"/>
    </Grid.ColumnDefinitions>

    <!-- Nombre del boss encima de la barra -->
    <Viewbox x:Name="TextViewbox" Grid.Column="1" Grid.Row="2">
        <TextBlock x:Name="Text"
                   Text="Aquiles"
                   FontFamily="./#ForgottenUncial"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#FFC73D05"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>
    </Viewbox>

    <Viewbox x:Name="BossBarViewbox" Grid.Column="1" Grid.Row="3" Stretch="Uniform">

        <Grid x:Name="BossBarRoot" Width="840" Height="120">

            <!-- Marco exterior: nunca se toca -->
            <Image x:Name="BossbarImage"
                   Source="Textures/Bossbar.png"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

            <Grid x:Name="BossBarFill"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  ClipToBounds="True"
                  Margin="106,46,0,0" Width="627" Height="19.5">
                <Image x:Name="InteriorImage"
                       Source="Textures/BossbarInterior.png"
                       Stretch="Fill"
                       HorizontalAlignment="Left"
                       Width="627" Height="19.5"/>
            </Grid>

        </Grid>
    </Viewbox>

</Grid>