<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  d:DesignWidth="1280" d:DesignHeight="720">

    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════
                 TOGGLE STYLE
                 ═══════════════════════════════════════════════ -->
            <Style x:Key="SettingToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#FFD4C5A9"/>
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label -->
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LabelShift" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Track -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Borde exterior -->
                                    <Border x:Name="TrackBorder"
                                            Width="64" Height="34"
                                            CornerRadius="17"
                                            Background="#FF1A1410"
                                            BorderBrush="#FF6B5B3E"
                                            BorderThickness="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="TrackGlow"
                                                              Color="#FFC8A84B"
                                                              BlurRadius="0"
                                                              ShadowDepth="0"
                                                              Opacity="0"/>
                                        </Border.Effect>
                                    </Border>
                                    
                                    <!-- Relleno dorado -->
                                    <Border x:Name="TrackFill"
                                            Width="64" Height="34"
                                            CornerRadius="17"
                                            Background="#FFC8A84B"
                                            Opacity="0"/>

                                    <!-- Thumb -->
                                    <Ellipse x:Name="Thumb"
                                             Width="26" Height="26"
                                             Fill="#FFE8D5A3"
                                             Stroke="#FF8B7355"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="3,0,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- CHECKED -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="32" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TrackFill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="8" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackFill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="TrackGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFD700"/>
                                </Trigger>

                                <!-- FOCUSED -->
                                <Trigger Property="IsFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LabelShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="8" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LabelShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFD700"/>
                                </Trigger>

                                <!-- PRESSED -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Thumb"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="22" Duration="0:0:0.06"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Thumb"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="26" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 RESOLUTION SELECTOR STYLE
                 ═══════════════════════════════════════════════ -->
            <Style x:Key="ResolutionSelectorStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FFD4C5A9"/>
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Label -->
                                <TextBlock x:Name="Label"
                                           Text="RESOLUTION"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LabelShift" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Selector box -->
                                <Border x:Name="SelectorBox"
                                        Grid.Column="1"
                                        Background="#FF1A1410"
                                        BorderBrush="#FF6B5B3E"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="2">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="SelGlow"
                                                          Color="#FFC8A84B"
                                                          BlurRadius="0"
                                                          ShadowDepth="0"
                                                          Opacity="0"/>
                                    </Border.Effect>

                                    <StackPanel Orientation="Horizontal">
                                        <!-- Flecha izquierda -->
                                        <Border Width="38" Height="38"
                                                CornerRadius="5"
                                                Background="#FF0D0A07"
                                                Margin="2">
                                            <TextBlock x:Name="ArrowLeft"
                                                       Text="◄"
                                                       FontSize="20"
                                                       Foreground="#FFB8960A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Separador -->
                                        <Rectangle Width="1" Fill="#FF3D2E1E" Margin="4,8"/>

                                        <!-- Valor -->
                                        <Border Width="160" Height="38"
                                                CornerRadius="5"
                                                Background="#FF0D0A07"
                                                Margin="2">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#003D2E1E"/>
                                                    <GradientStop Offset="0.5" Color="#FF6B5B3E"/>
                                                    <GradientStop Offset="1" Color="#003D2E1E"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>1</Border.BorderThickness>
                                            <TextBlock x:Name="ResValue"
                                                       Text="{Binding CurrentResolutionText}"
                                                       FontFamily="./#ForgottenUncial"
                                                       FontSize="24"
                                                       Foreground="#FFFFD700"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Separador -->
                                        <Rectangle Width="1" Fill="#FF3D2E1E" Margin="4,8"/>

                                        <!-- Flecha derecha -->
                                        <Border Width="38" Height="38"
                                                CornerRadius="5"
                                                Background="#FF0D0A07"
                                                Margin="2">
                                            <TextBlock x:Name="ArrowRight"
                                                       Text="►"
                                                       FontSize="20"
                                                       Foreground="#FFB8960A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- FOCUSED -->
                                <Trigger Property="IsFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="ResFocusSB">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LabelShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="8" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="10" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="SelGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ResFocusSB"/>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="LabelShift"
                                                                 Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="SelGlow"
                                                                 Storyboard.TargetProperty="BlurRadius"
                                                                 To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="SelGlow"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFD700"/>
                                    <Setter TargetName="ArrowLeft" Property="Foreground" Value="#FFFFD700"/>
                                    <Setter TargetName="ArrowRight" Property="Foreground" Value="#FFFFD700"/>
                                </Trigger>

                                <!-- PRESSED -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BoxScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.96" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="BoxScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.96" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BoxScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BoxScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════════════════════════════════════
                 TEXT BUTTON (BACK) - El original que pediste
                 ═══════════════════════════════════════════════ -->
            <Style x:Key="TextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel x:Name="ButtonContent" Orientation="Horizontal" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </StackPanel.RenderTransform>

                                <Image x:Name="ArrowL" Source="Textures/Arrow.PNG" Width="30" Height="30" Margin="0,0,15,0" Visibility="Hidden" Opacity="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="ArrowLTrans" X="-30"/>
                                    </Image.RenderTransform>
                                </Image>

                                <TextBlock x:Name="TextContent"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Image x:Name="ArrowR" Source="Textures/Arrow.PNG" Width="30" Height="30" Margin="15,0,0,0" Visibility="Hidden" Opacity="0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="-1"/>
                                            <TranslateTransform x:Name="ArrowRTrans" X="30"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </StackPanel>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="HoverFocusStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ArrowL" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowR" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowLTrans" Storyboard.TargetProperty="X" From="-15" To="-5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowRTrans" Storyboard.TargetProperty="X" From="15" To="5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="HoverFocusStoryboard"/>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowL" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowR" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowLTrans" Storyboard.TargetProperty="X" To="-30" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowRTrans" Storyboard.TargetProperty="X" To="30" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="ArrowL" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ArrowR" Property="Visibility" Value="Visible"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.05"/>
                                                <ColorAnimation Storyboard.TargetName="TextContent" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FFBBBBBB" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Storyboards -->
            <Storyboard x:Key="Intro">
                <DoubleAnimation Storyboard.TargetName="DimOverlay" Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="0:0:0.4"/>
            </Storyboard>

            <Storyboard x:Key="FadeOut">
                <DoubleAnimation Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="DimOverlay" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.3"/>
            </Storyboard>
        </ResourceDictionary>
    </Grid.Resources>

    <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Intro}"/>
        </EventTrigger>
    </Grid.Triggers>

    <Rectangle x:Name="DimOverlay" Fill="#AA000000" Opacity="0" IsHitTestVisible="False"/>

    <Grid x:Name="LayoutRoot" Opacity="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="771*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="1">
            <Image Source="Textures/Menu.PNG"/>
        </Viewbox>

        <Grid Grid.Column="1" Margin="69,114,69,79">
            <Grid.RowDefinitions>
                <RowDefinition Height="45*"/>
                <RowDefinition Height="95*"/>
                <RowDefinition Height="387*"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="1" Stretch="Uniform">
                <TextBlock Text="GRAPHICS"
                           FontFamily="./#ForgottenUncial"
                           FontSize="65"
                           Foreground="White"
                           TextAlignment="Center"
                           Width="445"/>
            </Viewbox>

            <Viewbox Grid.Row="2" Stretch="Uniform" Height="398" Width="500">
                <Grid Height="322" Width="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="68*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="68*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="68*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="68*"/>
                        <RowDefinition Height="24*"/>
                    </Grid.RowDefinitions>

                    <ToggleButton Grid.Row="1" 
                                  Content="FULLSCREEN"
                                  Style="{StaticResource SettingToggleStyle}"
                                  IsChecked="{Binding IsFullscreen}"/>

                    <ToggleButton Grid.Row="3" 
                                  Content="ANTI-ALIASING"
                                  Style="{StaticResource SettingToggleStyle}"
                                  IsChecked="{Binding IsAntiAliasing}"/>

                    <Button Grid.Row="5"
                            Style="{StaticResource ResolutionSelectorStyle}"
                            Command="{Binding Commands[CycleResolution]}"/>

                    <Button x:Name="BackButton"
                            Grid.Row="7"
                            Style="{StaticResource TextButtonStyle}"
                            Content="BACK"
                            Command="{Binding Commands[BackButton]}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseEnter">
                                <noesis:SetFocusAction/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Grid>