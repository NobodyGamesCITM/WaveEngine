<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         Stretch="Uniform" d:DesignWidth="1280" d:DesignHeight="720">

    <Grid Width="1920" Height="1080">

        <Grid.Resources>
            <Storyboard x:Key="BossBarFadeIn"/>
            <Storyboard x:Key="BossBarFadeOut"/>
        </Grid.Resources>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource BossBarFadeIn}"/>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="754*"/>
            <RowDefinition Height="76*"/>
            <RowDefinition Height="196*"/>
            <RowDefinition Height="49*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="580*"/>
            <ColumnDefinition Width="760*"/>
            <ColumnDefinition Width="580*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="BossbarGrid" Grid.Row="3" Grid.Column="1">
            <Grid x:Name="BossBarInterior" Height="120">

                <Grid x:Name="HealthBar"
                      ClipToBounds="True"
                      HorizontalAlignment="Left"
                      Margin="6,80,0,-6" Width="748">
                    <Image x:Name="Healthbar_Image"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="Textures/Bossbar_Health.PNG"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" Width="748"/>
                </Grid>

                <Grid x:Name="ShieldBar_Grid"
                      ClipToBounds="True"
                      Margin="43,32,0,60"
                      HorizontalAlignment="Left"
                      Width="674">
                    <Image x:Name="ShieldBarImage"
                           HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="Textures/Bossbar_Shield.PNG"
                           Stretch="None"
                           Margin="0,0,0,-4"
                           Width="674"/>
                </Grid>

            </Grid>

            <Grid x:Name="BossBarExterior" ClipToBounds="True">
                <Image x:Name="BossbarExterior_Image"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="Textures/Bossbar.png"/>
            </Grid>
        </Grid>
    </Grid>
</Viewbox>