<Grid x:Name="LayoutRoot"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
d:DesignWidth="1280" d:DesignHeight="720">

    <Grid.Background>
        <SolidColorBrush Color="#00000000"/>
    </Grid.Background>

    <Grid.Resources>
        <Storyboard x:Key="PotionAppear">

            <DoubleAnimation
                Storyboard.TargetName="PotionScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.5" To="1.0"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="PotionScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.5" To="1.0"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

        </Storyboard>
    </Grid.Resources>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1280" Height="720">

            <Grid x:Name="ItemObtainedPanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="300"
                  Height="360">

                <!-- Fondo con borde dorado -->
                <Border CornerRadius="12" BorderThickness="2">
                    <Border.Background>
                        <SolidColorBrush Color="#E6000000"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFDDAA44"/>
                    </Border.BorderBrush>
                </Border>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <TextBlock x:Name="ItemObtainedText"
                               Grid.Row="0"
                               Text="¡Poción obtenida!"
                               FontSize="22"
                               FontFamily="Times New Roman"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="#FFDDAA44"/>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Separador superior -->
                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="#66DDAA44"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Imagen de la poción -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PotionImage"
                               Source="Textures/Pocion.PNG"
                               Width="120" Height="120"
                               Opacity="1"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                             <TransformGroup>
                                <ScaleTransform x:Name="PotionScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="PotionRotate" Angle="0" CenterX="60" CenterY="60"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

                    <!-- Separador inferior -->
                    <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="#66DDAA44"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Botón reclamar -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Image x:Name="ItemObtainedKeyIcon"
                               Source="Textures/F.PNG"
                               Width="32" Height="32"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                        <Image x:Name="ItemObtainedGamepadIcon"
                               Source="Textures/A.PNG"
                               Width="32" Height="32"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"/>

                        <TextBlock Text="Reclamar"
                                   FontSize="20"
                                   FontFamily="Arial"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#FFCCCCCC"/>
                            </TextBlock.Foreground>
                        </TextBlock>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>
    </Viewbox>

</Grid>
