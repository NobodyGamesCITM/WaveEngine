<Grid x:Name="LayoutRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Border Background="Black"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <Viewbox Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <Grid Width="1920" Height="1080">

                <Grid x:Name="CinematicPanel" Visibility="Visible">

                    <Grid x:Name="Page1" Visibility="Visible" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="960"/>
                            <ColumnDefinition Width="960"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="540"/>
                            <RowDefinition Height="540"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Page1_V1" Opacity="0" Background="Black"
                                Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                Visibility="Visible" BorderThickness="10,10,5,10" ClipToBounds="True">
                            <Image Source="Textures/1.png" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page1_V2" Opacity="0" Background="Black"
                                Grid.Column="1" Grid.Row="0"
                                Visibility="Visible" BorderThickness="5,10,10,5" ClipToBounds="True">
                            <Image Source="Textures/2.png" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page1_V3" Opacity="0" Background="Black"
                                Grid.Column="1" Grid.Row="1"
                                Visibility="Visible" BorderThickness="5,5,10,10" ClipToBounds="True">
                            <Image Source="Textures/3.png" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="Page2" Visibility="Visible" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="960"/>
                            <ColumnDefinition Width="960"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="540"/>
                            <RowDefinition Height="540"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Page2_V1" Opacity="0" Background="Black"
                                Grid.Column="0" Grid.Row="0"
                                Visibility="Visible" BorderThickness="10,10,5,5" ClipToBounds="True">
                            <Image Source="Textures/4.PNG" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page2_V2" Opacity="0" Background="Black"
                                Grid.Column="1" Grid.Row="0"
                                Visibility="Visible" BorderThickness="5,10,10,5" ClipToBounds="True">
                            <Image Source="Textures/5.PNG" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page2_V3" Opacity="0" Background="Black"
                                Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                Visibility="Visible" BorderThickness="10,5,10,10" ClipToBounds="True">
                            <Image Source="Textures/6.PNG" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="Page3" Visibility="Visible" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="960"/>
                            <ColumnDefinition Width="960"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="540"/>
                            <RowDefinition Height="540"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Page3_V1" Opacity="0" Background="Black"
                                Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                Visibility="Visible" BorderThickness="10,10,10,5" ClipToBounds="True">
                            <Image Source="Textures/7.png" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page3_V2" Opacity="0" Background="Black"
                                Grid.Column="0" Grid.Row="1"
                                Visibility="Visible" BorderThickness="10,5,5,10" ClipToBounds="True">
                            <Image Source="Textures/88.png" Stretch="UniformToFill"/>
                        </Border>

                        <Border x:Name="Page3_V3" Opacity="0" Background="Black"
                                Grid.Column="1" Grid.Row="1"
                                Visibility="Visible" BorderThickness="5,5,10,10" ClipToBounds="True">
                            <Image Source="Textures/9.png" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="CinematicFade"
                          Visibility="Visible"
                          IsHitTestVisible="False">
                        <Grid.Background>
                            <SolidColorBrush Color="#FF000000"/>
                        </Grid.Background>
                    </Grid>

                </Grid>

            </Grid>
        </Viewbox>
    </Border>
</Grid>