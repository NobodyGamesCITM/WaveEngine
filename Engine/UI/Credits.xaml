                                <TextBlock Text="Pau" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Technical Artist · Level Designer" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Toni" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="UI Programmer" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="56" Fill="#2A2420" HorizontalAlignment="Center"/>

                            <!-- ═══════════ ARTE ═══════════ -->
                            <StackPanel Margin="0,48,0,40">
                                <TextBlock Text="ARTE" FontFamily="Georgia" FontSize="18" Foreground="#997755" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                                <TextBlock Text="Arnau" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="3D Modeler · 3D Animator" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Arthur" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
