                            <Rectangle Width="1" Height="56" Fill="#2A2420" HorizontalAlignment="Center"/>

                            <StackPanel Margin="0,60,0,40">
                                <TextBlock Text="CON EL AGRADECIMIENTO ESPECIAL A" FontFamily="Georgia" FontSize="16" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                                <StackPanel Margin="0,0,0,28" HorizontalAlignment="Center">
                                    <Grid Width="220" Height="80">
                                        <Rectangle Fill="White"/>
                                        <Image Source="Textures/Noesis.png"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,28" HorizontalAlignment="Center">
                                    <Grid Width="220" Height="80">
                                        <Rectangle Fill="White"/>
                                        <Image Source="Textures/Wwise.png"/>
                                    </Grid>
                                    <TextBlock Text="AUDIO MIDDLEWARE" FontFamily="Georgia" FontSize="16" Foreground="#665544" HorizontalAlignment="Center" Margin="0,10,0,0"/>
