                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="220" Height="80">
                                        <Rectangle Fill="#0A0A0A"/>
                                        <Border BorderBrush="#2A2420" BorderThickness="1"/>
                                        <Image Source="Textures/WaveEngine.png"/>
                                    </Grid>
                                    <TextBlock Text="GAME ENGINE" FontFamily="Georgia" FontSize="16" Foreground="#665544" HorizontalAlignment="Center" Margin="0,10,0,0"/>
