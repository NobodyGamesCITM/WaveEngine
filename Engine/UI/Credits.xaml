                                <TextBlock Text="Kai" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="3D Modeler · Technical Artist" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Lara" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="3D Modeler · 3D Animator" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Maria" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="3D Modeler · UI/HUD Artist" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Marti Mira" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="3D Modeler · 3D Animator" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                            </StackPanel>

                            <Rectangle Width="1" Height="56" Fill="#2A2420" HorizontalAlignment="Center"/>

                            <!-- ═══════════ DISEÑO ═══════════ -->
                            <StackPanel Margin="0,48,0,40">
                                <TextBlock Text="DISE&#xD1;O" FontFamily="Georgia" FontSize="18" Foreground="#997755" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                                <TextBlock Text="Arnau P." FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Gameplay Designer · Puzzle Designer" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Mario" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
