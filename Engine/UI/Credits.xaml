                                <TextBlock Text="Asier Ulloa" FontFamily="Georgia" FontSize="28" Foreground="#F0EAE0" HorizontalAlignment="Center"/>
                                <TextBlock Text="LEAD GAME DESIGNER" FontFamily="Georgia" FontSize="15" Foreground="#887766" HorizontalAlignment="Center" Margin="0,4,0,6"/>
                                <TextBlock Text="Gameplay Designer · Level Designer" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                                <TextBlock Text="Clara Rodriguez" FontFamily="Georgia" FontSize="28" Foreground="#F0EAE0" HorizontalAlignment="Center"/>
