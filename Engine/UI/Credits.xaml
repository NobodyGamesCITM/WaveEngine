                                <TextBlock Text="Marti Mach" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Enemy Designer · Level Designer · QA" FontFamily="Georgia" FontSize="15" Foreground="#665544" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                                <TextBlock Text="Roger" FontFamily="Georgia" FontSize="28" Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
