                            </StackPanel>

                            <Rectangle Width="1" Height="56" Fill="#2A2420" HorizontalAlignment="Center"/>

                            <!-- ═══════════ PROGRAMACIÓN ═══════════ -->
                            <StackPanel Margin="0,48,0,40">
                                <TextBlock Text="PROGRAMACI&#xD3;N" FontFamily="Georgia" FontSize="18" Foreground="#997755" HorizontalAlignment="Center" Margin="0,0,0,24"/>

