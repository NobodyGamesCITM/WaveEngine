<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
  d:DesignWidth="1280" d:DesignHeight="720">

    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingToggleStyle" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="#F0F0F0"
                                           VerticalAlignment="Center"/>

                                <Border x:Name="Track"
                                        Grid.Column="1"
                                        Width="60" Height="30"
                                        CornerRadius="15"
                                        Background="#333333"
                                        BorderBrush="#555555"
                                        BorderThickness="1">
                                    <Ellipse x:Name="Thumb"
                                             Width="24" Height="24"
                                             Fill="White"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="2,0,0,0"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#FFC8A84B"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel x:Name="ButtonContent" Orientation="Horizontal"
                                        HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </StackPanel.RenderTransform>

                                <Image x:Name="ArrowL" Source="Textures/Arrow.PNG"
                                       Width="30" Height="30" Margin="0,0,15,0"
                                       Visibility="Hidden" Opacity="0" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TranslateTransform x:Name="ArrowLTrans" X="-30"/>
                                    </Image.RenderTransform>
                                </Image>

                                <TextBlock x:Name="TextContent"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="#F0F0F0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Image x:Name="ArrowR" Source="Textures/Arrow.PNG"
                                       Width="30" Height="30" Margin="15,0,0,0"
                                       Visibility="Hidden" Opacity="0" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="-1"/>
                                            <TranslateTransform x:Name="ArrowRTrans" X="30"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </StackPanel>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="HoverFocusStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="TextContent" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowL" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowR" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowLTrans" Storyboard.TargetProperty="X" From="-15" To="-5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowRTrans" Storyboard.TargetProperty="X" From="15" To="5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="HoverFocusStoryboard"/>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="TextContent" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#F0F0F0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowL" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowR" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowLTrans" Storyboard.TargetProperty="X" To="-30" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowRTrans" Storyboard.TargetProperty="X" To="30" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                    <Setter TargetName="ArrowL" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ArrowR" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.05"/>
                                                <ColorAnimation Storyboard.TargetName="TextContent" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#AAAAAA" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <ColorAnimation Storyboard.TargetName="TextContent" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ArrowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="./#ForgottenUncial"/>
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="Foreground" Value="#FFC840"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <Image x:Name="ArrowIcon"
                                       Source="Textures/Arrow.PNG"
                                       Width="25" Height="25"
                                       Opacity="0.6"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="FlipScale" ScaleX="1"/>
                                            <TranslateTransform x:Name="ArrowTrans" X="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="◄">
                                    <Setter TargetName="FlipScale" Property="ScaleX" Value="-1"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.85" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.85" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <Trigger Property="IsFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="ArrowFocusStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ArrowIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowTrans" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ArrowFocusStoryboard"/>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowIcon" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="ArrowTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Storyboard x:Key="Intro">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                              Storyboard.TargetName="DimOverlay">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                              Storyboard.TargetName="TitleViewbox">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)"
                                              Storyboard.TargetName="TitleViewbox">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.1"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.5"  Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><CircleEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                              Storyboard.TargetName="FullScreenRow">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.2"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)"
                                              Storyboard.TargetName="FullScreenRow">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.2"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.6"  Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><CircleEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                              Storyboard.TargetName="ResolutionRow">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.4"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.75" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)"
                                              Storyboard.TargetName="ResolutionRow">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.4"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.8"  Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><CircleEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                              Storyboard.TargetName="BackButton">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.5"  Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)"
                                              Storyboard.TargetName="BackButton">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.5"  Value="-200"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.9"  Value="0">
                        <EasingDoubleKeyFrame.EasingFunction><CircleEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="FadeOut">
                <DoubleAnimation Storyboard.TargetName="FadeOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="0:0:1.5">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="DimOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.4">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="OnResolutionChanged">
                <DoubleAnimation Storyboard.TargetName="ResolutionValue"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0.3" To="1.0" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </ResourceDictionary>
    </Grid.Resources>

    <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Intro}"/>
        </EventTrigger>
    </Grid.Triggers>

    <Rectangle x:Name="DimOverlay" Fill="#AA000000" Opacity="0" IsHitTestVisible="False"/>

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="771*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="112*"/>
            <RowDefinition Height="530*"/>
            <RowDefinition Height="78*"/>
        </Grid.RowDefinitions>

        <Viewbox x:Name="BackgroundImageViewBox" Width="688" Height="688" Grid.Column="1" Grid.RowSpan="3">
            <Image x:Name="BackgroundImage" Source="Textures/Menu.PNG"/>
        </Viewbox>

        <Grid Margin="44,36" Grid.Column="1" RenderTransformOrigin="0.5,0.5" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="54*"/>
                <RowDefinition Height="76*"/>
                <RowDefinition Height="392*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="105*"/>
                <ColumnDefinition Width="570*"/>
                <ColumnDefinition Width="105*"/>
            </Grid.ColumnDefinitions>

            <Viewbox x:Name="TitleViewbox" Grid.Row="1" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Viewbox.RenderTransform>
                <TextBlock Text="GRAPHICS" FontFamily="./#Cinzel Decorative" FontSize="65"
                           Foreground="White" FontWeight="Bold"
                           TextAlignment="Center"
                           Width="445" Margin="0,4,0,-4"/>
            </Viewbox>

            <Viewbox x:Name="ButtonsViewbox" Stretch="Uniform" Margin="39,25,39,20" Grid.Row="2" Grid.Column="1">
              <Grid x:Name="ButtonsGrid" Width="570">
                <Grid.RowDefinitions>
                    <!-- Row 0: top padding -->
                    <RowDefinition Height="20"/>
                    <!-- Row 1: FULLSCREEN toggle -->
                    <RowDefinition Height="44"/>
                    <!-- Row 2: gap -->
                    <RowDefinition Height="30"/>
                    <!-- Row 3: ANTI-ALIASING toggle -->
                    <RowDefinition Height="44"/>
                    <!-- Row 4: gap -->
                    <RowDefinition Height="30"/>
                    <!-- Row 5: RESOLUTION picker -->
                    <RowDefinition Height="52"/>
                    <!-- Row 6: gap -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                    <!-- Row 7: APPLY button -->
                    <RowDefinition Height="52"/>
                    <!-- Row 8: gap -->
                    <RowDefinition Height="28"/>
                    <!-- Row 9: BACK button -->
                    <RowDefinition Height="52"/>
                    <!-- Row 10: bottom padding -->
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="FullScreen"
                        Grid.Row="1"
                        Style="{StaticResource SettingToggleStyle}"
                        RenderTransformOrigin="0.5,0.5" Content="Fullscreen" Margin="0" FontFamily="./#Cinzel" FontWeight="Medium">
                    <CheckBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </CheckBox.RenderTransform>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseEnter">
                            <noesis:SetFocusAction/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </CheckBox>
                <Border x:Name="FullScreenRow"
                        Grid.Row="1"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5" Margin="0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <CheckBox x:Name="AntiAliasing"
                        Grid.Row="3"
                        Style="{StaticResource SettingToggleStyle}"
                        RenderTransformOrigin="0.5,0.5" Content="Anti-Aliasing" Margin="0" FontFamily="./#Cinzel" FontWeight="Medium">
                    <CheckBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </CheckBox.RenderTransform>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseEnter">
                            <noesis:SetFocusAction/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </CheckBox>
                <Border x:Name="AntiAliasingRow"
                        Grid.Row="3"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5" Margin="0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <Grid x:Name="ResolutionRow" Grid.Row="5" RenderTransformOrigin="0.5,0.5" Margin="0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontFamily="./#Cinzel" FontSize="26" FontWeight="Medium"
                            Foreground="#F0F0F0" Text="Resolution"
                            VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4,8" Background="#FF333333" BorderBrush="#FF5A5A5A">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ResolutionPrev"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    Content="◄" RenderTransformOrigin="0.5,0.5">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="MouseEnter">
                                        <noesis:SetFocusAction/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-180"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                            <TextBlock x:Name="ResolutionValue"
                                    Text="1920 x 1080" FontFamily="./#Cinzel"
                                    FontSize="22"
                                    Foreground="White"
                                    Width="140" FontWeight="Bold" TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button x:Name="ResolutionNext"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    Content="►">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="MouseEnter">
                                        <noesis:SetFocusAction/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button x:Name="ApplyButton"
                        Grid.Row="8"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5" Content="Apply" Margin="0" FontFamily="./#Cinzel" FontWeight="Medium">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseEnter">
                            <noesis:SetFocusAction/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>

                <Button x:Name="BackButton"
                        Grid.Row="10"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5" Content="Back" Margin="0" FontFamily="./#Cinzel" FontWeight="Medium">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseEnter">
                            <noesis:SetFocusAction/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Button>
            </Grid>
            </Viewbox>
        </Grid>

        <Rectangle x:Name="FadeOverlay" Grid.ColumnSpan="3" Opacity="0" Fill="Black" IsHitTestVisible="False" Grid.RowSpan="3" Margin="0"/>
    </Grid>
</Grid>