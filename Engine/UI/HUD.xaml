    <Grid x:Name="MissionGrid">
        <Grid.Resources>

            <Storyboard x:Name="MissionExpand">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    From="0.55" To="1.0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    From="0.7" To="1.0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="TextViewBox"
                    Storyboard.TargetProperty="Opacity"
                    From="0.35" To="1.0"
                    Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Name="MissionCollapse">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="0.55"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="0.7"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="TextViewBox"
                    Storyboard.TargetProperty="Opacity"
                    To="0.35"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="MissionCountBump">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    From="1.18" To="1.0"
                    Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    From="1.18" To="1.0"
                    Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Grid.Resources>

