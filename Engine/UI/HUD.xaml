                        <Border.BorderBrush><SolidColorBrush Color="#FFFFFFFF"/></Border.BorderBrush>
                        <Border.Background><SolidColorBrush Color="#FF1A1500"/></Border.Background>
                        <TextBlock Text="«Te traeré de vuelta, padre. No consentiré que las sombras lo dominen. Parto en su busca, y no volveré sin él.»"
                                   FontSize="28" FontFamily="Times New Roman" FontStyle="Italic" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="60,30,60,30">
                            <TextBlock.Foreground><SolidColorBrush Color="#FFFFE082"/></TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid x:Name="Page3" Visibility="Collapsed">
                    <Border x:Name="Page3_V1" Visibility="Collapsed" BorderThickness="2" Margin="40,40,1000,40">
                        <Border.BorderBrush><SolidColorBrush Color="#FFFFFFFF"/></Border.BorderBrush>
                        <Border.Background><SolidColorBrush Color="#FF111111"/></Border.Background>
                        <TextBlock Text="Vistazo introductorio al juego. Primer plano de la barca de Telémaco, junto al búho, y a lo lejos la isla de Perséfone."
                                   FontSize="26" FontFamily="Times New Roman" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40,40,40,40">
                            <TextBlock.Foreground><SolidColorBrush Color="#FFFFFFFF"/></TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <Border x:Name="Page3_V2" Visibility="Collapsed" BorderThickness="2" Margin="924,40,40,562">
                        <Border.BorderBrush><SolidColorBrush Color="#FFFFFFFF"/></Border.BorderBrush>
                        <Border.Background><SolidColorBrush Color="#FF111111"/></Border.Background>
                        <TextBlock Text="Fuerte tormenta y marea por llegar. El mismo plano, pero sin la isla al fondo."
                                   FontSize="24" FontFamily="Times New Roman" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30,30,30,30">
                            <TextBlock.Foreground><SolidColorBrush Color="#FFFFFFFF"/></TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <Border x:Name="Page3_V3" Visibility="Collapsed" BorderThickness="2" Margin="924,518,40,40">
                        <Border.BorderBrush><SolidColorBrush Color="#FFFFFFFF"/></Border.BorderBrush>
                        <Border.Background><SolidColorBrush Color="#FF111111"/></Border.Background>
                        <TextBlock Text="El barco es dado la vuelta y Telémaco cae al agua agarrado a un tablón. Atenea como búho se acerca al pobre chico."
                                   FontSize="24" FontFamily="Times New Roman" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30,30,30,30">
                            <TextBlock.Foreground><SolidColorBrush Color="#FFFFFFFF"/></TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                </Grid>

            </Grid>

            <Grid x:Name="CinematicFade" Visibility="Collapsed" IsHitTestVisible="False" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <Grid.Background>
                    <SolidColorBrush Color="#FF000000"/>
                </Grid.Background>
            </Grid>

        </Grid>
    </Viewbox>

    <Grid x:Name="MissionGrid">
        <Grid.Resources>
            <Storyboard x:Name="MissionExpand">
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TextViewBox" Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.3"/>
            </Storyboard>
            <Storyboard x:Name="MissionCollapse">
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.55" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TextViewBox" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="MissionCountBump">
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleX" From="1.18" To="1.0" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="MissionScaleTransform" Storyboard.TargetProperty="ScaleY" From="1.18" To="1.0" Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1599*"/>
            <ColumnDefinition Width="288*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="214*"/>
            <RowDefinition Height="125*"/>
            <RowDefinition Height="741*"/>
        </Grid.RowDefinitions>

        <Viewbox x:Name="MissionBackgroundViewBox" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Right"/>
        <Viewbox x:Name="MissionTextViewBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"/>
        <Canvas Margin="-7,0,7,0" Grid.RowSpan="3">
            <Grid x:Name="LockOnPrompt" Width="30" Height="30" Visibility="Collapsed">
                <Image x:Name="LockOn_Gamepad" Source="Textures/R3.PNG" Width="30" Height="30"/>
                <Image x:Name="LockOn_Keyboard" Source="Textures/R.PNG" Width="30" Height="30"/>
            </Grid>
            <Grid x:Name="InteractPrompt" Width="30" Height="30" Visibility="Collapsed">
                <Image x:Name="InputKeyText" RenderTransformOrigin="0.5,0.5" Source="Textures/F.PNG" Width="30" Height="30">
                    <Image.RenderTransform><TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform/><TranslateTransform/></TransformGroup></Image.RenderTransform>
                    <Image.Transform3D><noesis:CompositeTransform3D/></Image.Transform3D>
                </Image>
                <Image x:Name="InputGamepadIcon" RenderTransformOrigin="0.5,0.5" Source="Textures/A.PNG" Width="30" Height="30">
                    <Image.RenderTransform><TransformGroup><ScaleTransform/><SkewTransform/><RotateTransform/><TranslateTransform/></TransformGroup></Image.RenderTransform>
                    <Image.Transform3D><noesis:CompositeTransform3D/></Image.Transform3D>
                </Image>
            </Grid>
            <Grid x:Name="StatuePrompt" Width="30" Height="30" Visibility="Collapsed">
                <Image x:Name="Statue_Gamepad" Source="Textures/X.PNG" Width="30" Height="30"/>
                <Image x:Name="Statue_Keyboard" Source="Textures/E.PNG" Width="30" Height="30"/>
            </Grid>
        </Canvas>

        <Grid x:Name="SaveIconContainer"
            Grid.ColumnSpan="3"
            Grid.RowSpan="3"
            IsHitTestVisible="False">

            <!-- Responsive como el HUD -->
            <Viewbox Stretch="Uniform"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <!-- Canvas de referencia 1920x1080 -->
                <Grid Width="1920" Height="1080">

                    <Viewbox x:Name="SaveIconContainer_ViewBox"
                            Width="100"
                            Height="100"
                            Opacity="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,90,40">
                        <Viewbox.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform Y="40"/>
                            </TransformGroup>
                        </Viewbox.RenderTransform>

                        <Grid x:Name="SaveIconGrid">
                            <Image x:Name="Mask1"
                                Width="100"
                                Height="100"
                                Opacity="0"
                                Source="Textures/Apolo.PNG"
                                Stretch="Uniform"/>

                            <Image x:Name="Mask2"
                                Width="100"
                                Height="100"
                                Opacity="0"
                                Source="Textures/Ares.PNG"
                                Stretch="Uniform"/>

                            <Image x:Name="Mask3"
                                Width="100"
                                Height="100"
                                Opacity="0"
                                Source="Textures/Hermes.PNG"
                                Stretch="Uniform"/>
                        </Grid>

                    </Viewbox>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Grid>
