                        <RadialGradientBrush RadiusX="0.18837637" Opacity="0.986" RadiusY="0.2747798" GradientOrigin="0.0699632,0.102248" Center="0.0699632,0.102248">
                            <RadialGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.0970609" CenterX="0.0666536"/>
                                    <SkewTransform CenterY="0.0970609" CenterX="0.0666536"/>
                                    <RotateTransform Angle="1.4686966" CenterX="0.06996321" CenterY="0.10224788"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </RadialGradientBrush.RelativeTransform>
                            <GradientStop Offset="0.358"/>
                            <GradientStop Color="#FF000000" Offset="0.62410766"/>
                            <GradientStop Color="#FF000000" Offset="0.51369244"/>
                        </RadialGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Image Source="Textures/CanviarMascaras.PNG" Margin="831,672,591,105"/>
                <Image Source="Textures/8.PNG" Margin="704,787,1124,201"/>
            </Grid>

        </Grid>
    </Viewbox>

    <!--
    ═══════════════════════════════════════════════════════════════════════════
    MissionGrid — contador de estatuas destruidas
    ═══════════════════════════════════════════════════════════════════════════
    -->
    <Grid x:Name="MissionGrid">
        <Grid.Resources>

            <Storyboard x:Name="MissionExpand">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    From="0.55" To="1.0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    From="0.7" To="1.0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="TextViewBox"
                    Storyboard.TargetProperty="Opacity"
                    From="0.35" To="1.0"
                    Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Name="MissionCollapse">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    To="0.55"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    To="0.7"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="TextViewBox"
                    Storyboard.TargetProperty="Opacity"
                    To="0.35"
                    Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="MissionCountBump">
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleX"
                    From="1.18" To="1.0"
                    Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="MissionScaleTransform"
                    Storyboard.TargetProperty="ScaleY"
                    From="1.18" To="1.0"
                    Duration="0:0:0.45">
                    <DoubleAnimation.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="2" Springiness="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1599*"/>
            <ColumnDefinition Width="288*"/>
            <ColumnDefinition Width="33*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="214*"/>
            <RowDefinition Height="125*"/>
            <RowDefinition Height="741*"/>
        </Grid.RowDefinitions>

        <Viewbox x:Name="MissionBackgroundViewBox" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="1" HorizontalAlignment="Right">
            <Image x:Name="MissionBackgroundImage" Source="Textures/MissionBackground.PNG"/>
        </Viewbox>
        <Viewbox x:Name="MissionTextViewBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <TextBlock x:Name="MissionText" TextWrapping="Wrap" FontFamily="./#ForgottenUncial" TextAlignment="Center" Text="0/3" />
        </Viewbox>
        <Canvas Margin="-7,0,7,0" Grid.ColumnSpan="3" Grid.RowSpan="3">
            <Grid x:Name="LockOnPrompt" Width="30" Height="30" Visibility="Collapsed">
                <Image x:Name="LockOn_Gamepad" Source="Textures/R3.PNG" Width="30" Height="30"/>
                <Image x:Name="LockOn_Keyboard" Source="Textures/Shift.PNG" Width="30" Height="30"/>
            </Grid>
            <Grid x:Name="InteractPrompt" Width="30" Height="30" Visibility="Collapsed">
                <Image x:Name="InputKeyText" RenderTransformOrigin="0.5,0.5" Source="Textures/F.PNG" Width="30" Height="30">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.Transform3D>
                        <noesis:CompositeTransform3D/>
                    </Image.Transform3D>
                </Image>
                <Image x:Name="InputGamepadIcon" RenderTransformOrigin="0.5,0.5" Source="Textures/A.PNG" Width="30" Height="30">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.Transform3D>
                        <noesis:CompositeTransform3D/>
                    </Image.Transform3D>
                </Image>
            </Grid>
        </Canvas>

    </Grid>

</Grid>
