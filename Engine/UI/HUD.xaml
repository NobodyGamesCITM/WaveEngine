            <Grid x:Name="ChangeMaskTutorialPanel" ColumnSpan="2" RowSpan="2" Visibility="Collapsed" Background="#00000000" IsHitTestVisible="False">
                <Rectangle Opacity="0.598" Fill="#FF000000" Stroke="#FF000000">
