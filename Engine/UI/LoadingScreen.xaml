<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  Background="#FF4D5052">

  <Grid Background="#FF000000">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1445*"/>
      <ColumnDefinition Width="255*"/>
      <ColumnDefinition Width="173*"/>
      <ColumnDefinition Width="47*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="900*"/>
      <RowDefinition Height="114*"/>
      <RowDefinition Height="66*"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
      <Storyboard x:Key="ExitStoryboard">
        <DoubleAnimation
          Storyboard.TargetName="MaskSlide"
          Storyboard.TargetProperty="Y"
          From="0" To="40"
          BeginTime="0:0:0.8"
          Duration="0:0:0.5">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseIn"/>
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation
          Storyboard.TargetName="MaskContainer"
          Storyboard.TargetProperty="Opacity"
          From="1" To="0"
          BeginTime="0:0:0.8"
          Duration="0:0:0.5">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseIn"/>
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
      </Storyboard>
    </Grid.Resources>

    <Viewbox x:Name="MaskContainer"
             Grid.Row="1" Grid.Column="2"
             Margin="29.5,0"
             Opacity="0">
      <Viewbox.RenderTransform>
        <TranslateTransform x:Name="MaskSlide" Y="40"/>
      </Viewbox.RenderTransform>

      <Grid Width="100" Height="100">

        <Image x:Name="Mask1"
               Width="100" Height="100"
               Opacity="0"
               Source="Textures/Apolo.PNG"
               Stretch="Uniform"/>

        <Image x:Name="Mask2"
               Width="100" Height="100"
               Opacity="0"
               Source="Textures/Ares.PNG"
               Stretch="Uniform"/>

        <Image x:Name="Mask3"
               Width="100" Height="100"
               Opacity="0"
               Source="Textures/Hermes.PNG"
               Stretch="Uniform"/>

        <Grid.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>

                <!-- Slide entrada desde abajo -->
                <DoubleAnimation
                  Storyboard.TargetName="MaskSlide"
                  Storyboard.TargetProperty="Y"
                  From="40" To="0"
                  Duration="0:0:0.7">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Fade in del contenedor -->
                <DoubleAnimation
                  Storyboard.TargetName="MaskContainer"
                  Storyboard.TargetProperty="Opacity"
                  From="0" To="1"
                  Duration="0:0:0.7">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>

                <!-- Mask1 -->
                <DoubleAnimationUsingKeyFrames
                  Storyboard.TargetName="Mask1"
                  Storyboard.TargetProperty="Opacity"
                  BeginTime="0:0:0.7"
                  RepeatBehavior="Forever"
                  Duration="0:0:2.4">
                  <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                  <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:0.80" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                  <EasingDoubleKeyFrame KeyTime="0:0:2.40" Value="0"/>
                </DoubleAnimationUsingKeyFrames>

                <!-- Mask2 -->
                <DoubleAnimationUsingKeyFrames
                  Storyboard.TargetName="Mask2"
                  Storyboard.TargetProperty="Opacity"
                  BeginTime="0:0:0.7"
                  RepeatBehavior="Forever"
                  Duration="0:0:2.4">
                  <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:0.80" Value="0"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:0.95" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                  <EasingDoubleKeyFrame KeyTime="0:0:1.45" Value="1"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:1.60" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                  <EasingDoubleKeyFrame KeyTime="0:0:2.40" Value="0"/>
                </DoubleAnimationUsingKeyFrames>

                <!-- Mask3 -->
                <DoubleAnimationUsingKeyFrames
                  Storyboard.TargetName="Mask3"
                  Storyboard.TargetProperty="Opacity"
                  BeginTime="0:0:0.7"
                  RepeatBehavior="Forever"
                  Duration="0:0:2.4">
                  <EasingDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:1.60" Value="0"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:1.75" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                  <EasingDoubleKeyFrame KeyTime="0:0:2.25" Value="1"/>
                  <EasingDoubleKeyFrame KeyTime="0:0:2.40" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseIn"/></EasingDoubleKeyFrame.EasingFunction>
                  </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>

              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
      </Grid>
    </Viewbox>

  </Grid>
</Page>