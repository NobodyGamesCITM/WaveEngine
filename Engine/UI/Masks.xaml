<Grid x:Name="LayoutRoot"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
d:DesignWidth="1920" d:DesignHeight="1080">

    <Grid.Background>
        <SolidColorBrush Color="#00000000"/>
    </Grid.Background>

    <Grid x:Name="MaskObtainedBackground"
          Visibility="Collapsed"
          Background="#BF000000"
          IsHitTestVisible="False"/>

    <Grid x:Name="ChangeMaskTutorialBackground"
          Visibility="Collapsed"
          IsHitTestVisible="False">
        <Rectangle x:Name="TutorialGradientRect"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <RadialGradientBrush
                    MappingMode="Absolute"
                    RadiusX="320"
                    RadiusY="160"
                    GradientOrigin="146,104"
                    Center="146,104">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="0.38"/>
                    <GradientStop Color="#AA000000" Offset="0.72"/>
                    <GradientStop Color="#CC000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>

    <Grid x:Name="ChangeMaskTutorialGradient" Visibility="Collapsed" IsHitTestVisible="False"/>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1920" Height="1080">

            <Grid x:Name="MaskObtainedPanel" Visibility="Collapsed" Background="#00000000"
                  IsHitTestVisible="False">
                <Image Source="Textures/PopUp.PNG" Margin="455,189,440,189"/>
                <TextBlock x:Name="MaskObtainedTitle" RenderTransformOrigin="0.5,0.5" Text="Has obtenido" Margin="0,0,0,970" HorizontalAlignment="Center" Visibility="Hidden" Foreground="#FFFFFFFF" FontFamily="Times New Roman" FontSize="70" TextAlignment="Center" TextWrapping="WrapWithOverflow">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform Y="32"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <Grid>
                    <Image x:Name="MaskImg_Ares"   Source="Textures/Ares.PNG" Margin="648,322,1151,626" Visibility="Collapsed"/>
                    <Image x:Name="MaskImg_Apolo"  Source="Textures/Apolo.PNG" Margin="578,333,1185,614" Visibility="Collapsed"/>
                    <Image x:Name="MaskImg_Hermes" Source="Textures/Hermes.PNG" Margin="578,323,1203,612" Visibility="Collapsed">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="MaskObtainedName" noesis:RichText.Text="MASK OF APOLO" Text="MASK OF ARES" Margin="0,367,0,648" HorizontalAlignment="Center" Visibility="Collapsed" Foreground="#FF817056" StrokeThickness="70" FontFamily="./#Cinzel" FontSize="50" FontStyle="Oblique" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Image x:Name="MaskImg_Apolo001" Source="Textures/Apolo.PNG" Margin="1182,331,582,616" Visibility="Collapsed"/>
                    <Image x:Name="MaskImg_Hermes001" Source="Textures/Hermes.PNG" Margin="1338,323,442,612" Visibility="Collapsed">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="MaskImg_Ares001" Source="Textures/Ares.PNG" Margin="1277,322,521,626" Visibility="Collapsed">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
                <StackPanel x:Name="MaskPanel_Hermes" Orientation="Horizontal" Width="831" Height="391" Margin="15,190,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="MaskSkill_Hermes_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Hermes_Attack.png" Width="290" Height="275" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Width="83" Height="100">
                        <Image x:Name="MaskKey_Q1_GP" Source="Textures/Y.PNG" Width="71" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q1_KB" Source="Textures/Q.PNG" Width="83" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Hermes_Run" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Hermes_Skill.png" Width="348" Height="279" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Width="105" Height="98">
                        <Image x:Name="MaskKey_Shift_GP" RenderTransformOrigin="0.5,0.5" Source="Textures/LT.PNG" Width="86" Height="77" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Shift_KB" RenderTransformOrigin="0.5,0.5" Source="Textures/Shift.PNG" Width="105" Height="98" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="MaskPanel_Apolo" Orientation="Horizontal" Width="624" Height="394" Margin="66,190,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="82" Height="82">
                        <Image x:Name="MaskKey_Q_GP" Source="Textures/Y.PNG" Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q_KB" Source="Textures/Q.PNG" Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Apolo_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/MainCharacter_Skill Apolo.png" Width="531" Height="303" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
                <StackPanel x:Name="MaskPanel_Ares" Orientation="Horizontal" Width="604" Height="380" Margin="15,208,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="84" Height="87">
                        <Image x:Name="MaskKey_Q2_GP" Source="Textures/Y.PNG" Width="69" Height="69" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q2_KB" Source="Textures/Q.PNG" Width="67" Height="87" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Ares_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Ares_Attack.png" Width="472" Height="351" Margin="0,0,0,6">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
            </Grid>

            <Grid x:Name="ChangeMaskTutorialPanel"
                  Visibility="Collapsed"
                  Background="#00000000"
                  IsHitTestVisible="False">
                <Image Source="Textures/CanviarMascaras.PNG" Margin="831,672,591,105"/>
                <Image Source="Textures/Cruceta.PNG" Margin="704,787,1124,201"/>
            </Grid>

        </Grid>
    </Viewbox>

</Grid>
