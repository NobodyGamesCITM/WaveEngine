<Grid x:Name="LayoutRoot"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
d:DesignWidth="1920" d:DesignHeight="1080">

    <Grid.Background>
        <SolidColorBrush Color="#00000000"/>
    </Grid.Background>

    <Grid x:Name="MaskObtainedBackground"
          Visibility="Collapsed"
          Background="#BF000000"
          IsHitTestVisible="False"/>

    <Grid x:Name="ChangeMaskTutorialBackground"
          Visibility="Collapsed"
          IsHitTestVisible="False">
        <Rectangle x:Name="TutorialGradientRect"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <RadialGradientBrush
                    MappingMode="Absolute"
                    RadiusX="320"
                    RadiusY="160"
                    GradientOrigin="146,104"
                    Center="146,104">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="0.38"/>
                    <GradientStop Color="#AA000000" Offset="0.72"/>
                    <GradientStop Color="#CC000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>

    <Grid x:Name="ChangeMaskTutorialGradient" Visibility="Collapsed" IsHitTestVisible="False"/>

    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="1920" Height="1080">

            <Grid x:Name="MaskObtainedPanel" Visibility="Collapsed"
                  Background="#00000000"
                  IsHitTestVisible="False">
                <Image Source="Textures/PopUp.PNG" Margin="455,189,440,189"/>
                <TextBlock x:Name="MaskObtainedTitle" RenderTransformOrigin="0.5,0.5" Text="Has obtenido" Margin="0,0,0,970" HorizontalAlignment="Center" Visibility="Hidden" Foreground="#FFFFFFFF" FontFamily="Times New Roman" FontSize="70" TextAlignment="Center" TextWrapping="WrapWithOverflow">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform Y="32"/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <Grid>
                    <Image x:Name="MaskImg_Ares"   Source="Textures/Ares.PNG"   Margin="524,368,1112,405" Visibility="Collapsed"/>
                    <Image x:Name="MaskImg_Apolo"  Source="Textures/Apolo.PNG"  Margin="521,386,1071,415" Visibility="Collapsed"/>
                    <Image x:Name="MaskImg_Hermes" Source="Textures/Hermes.PNG" Margin="533,394,1131,420" Visibility="Collapsed">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="MaskObtainedName" Margin="314,368,0,647" HorizontalAlignment="Center" Foreground="#FF5F5341" StrokeThickness="70" FontFamily="./#Cinzel" FontSize="50" TextAlignment="Center" TextWrapping="Wrap" TextDecorations="Underline"/>
                </Grid>
                <StackPanel x:Name="MaskPanel_Apolo" Orientation="Horizontal" Width="466" Margin="496,300,158,100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="82" Height="82">
                        <Image x:Name="MaskKey_Q_GP" Source="Textures/Y.PNG"   Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q_KB" Source="Textures/Q.PNG"   Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Apolo_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/MainCharacter_Skill Apolo.png" Width="355" Height="185" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
                <StackPanel x:Name="MaskPanel_Hermes" Orientation="Horizontal" Width="614.66406" Margin="297,180,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image x:Name="MaskSkill_Hermes_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Hermes_Attack.png" Width="185" Height="202" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Width="83" Height="100">
                        <Image x:Name="MaskKey_Q1_GP" Source="Textures/Y.PNG"     Width="83" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q1_KB" Source="Textures/Q.PNG"     Width="83" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Hermes_Run" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Hermes_Skill.png" Width="242" Height="171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Width="105" Height="98">
                        <Image x:Name="MaskKey_Shift_GP" RenderTransformOrigin="0.5,0.5" Source="Textures/LT.PNG"    Width="105" Height="98" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Shift_KB" RenderTransformOrigin="0.5,0.5" Source="Textures/Shift.PNG" Width="105" Height="98" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="MaskPanel_Ares" Orientation="Horizontal" Margin="300,200,0,70" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="84" Height="87">
                        <Image x:Name="MaskKey_Q2_GP" Source="Textures/Y.PNG" Width="83" Height="87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="MaskKey_Q2_KB" Source="Textures/Q.PNG" Width="84" Height="87" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Image x:Name="MaskSkill_Ares_Heavy" RenderTransformOrigin="0.5,0.5" Source="Textures/Tutorial_Ares_Attack.png" Width="423" Height="258">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </StackPanel>
            </Grid>

            <Grid x:Name="ChangeMaskTutorialPanel"
                  Visibility="Collapsed"
                  Background="#00000000"
                  IsHitTestVisible="False">
                <Image Source="Textures/CanviarMascaras.PNG" Margin="831,672,591,105"/>
                <Image Source="Textures/Cruceta.PNG" Margin="704,787,1124,201"/>
            </Grid>

        </Grid>
    </Viewbox>

</Grid>
